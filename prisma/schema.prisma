generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_DIRECT")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username               String                @unique @db.VarChar(50)
  email                  String                @unique @db.VarChar(255)
  emailVerified          DateTime?             @db.Timestamptz(6)
  password               String?               @db.VarChar(255)
  image                  String?
  bio                    String?
  location               String?               @db.VarChar(100)
  role                   UserRole              @default(USER)
  experiencePoints       Int                   @default(0)
  badges                 String[]              @db.VarChar(50)
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  favAccords             String[]              @db.VarChar(50)
  favNotes               String[]              @db.VarChar(50)
  favPerfumeIds          String[]              @db.VarChar(255)
  favPerfumers           String[]              @db.VarChar(100)
  isActivityPublic       Boolean               @default(true)
  isWardrobePublic       Boolean               @default(false)
  emailNotifWeeklyDigest Boolean               @default(true)
  unsubscribedFromAll    Boolean               @default(false)
  testData               Boolean               @default(false)
  accounts               Account[]
  activityLogs           ActivityLog[]
  articleComments        ArticleComment[]
  articles               Article[]
  communitySubmissions   CommunitySubmission[]
  following              Follow[]              @relation("Follower")
  followers              Follow[]              @relation("Following")
  notifications          Notification[]
  ratings                Rating[]
  reviews                Review[]
  sessions               Session[]
  similarVotes           SimilarPerfumeVote[]
  wardrobe               WardrobeEntry[]
  brandFollows           BrandFollow[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @db.VarChar(255)
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  expires   DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([email])
  @@index([code])
  @@index([expires])
  @@map("password_reset_tokens")
}

model Review {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @db.Uuid
  perfumeId    String          @db.VarChar(255)
  rating       Int             @db.SmallInt
  title        String?         @db.VarChar(200)
  text         String
  photos       String[]
  tags         String[]        @db.VarChar(50)
  helpfulCount Int             @default(0)
  likeCount    Int             @default(0)
  isEdited     Boolean         @default(false)
  editedAt     DateTime?       @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  longevity    Int?            @db.SmallInt
  sillage      Int?            @db.SmallInt
  deletedAt    DateTime?
  isDeleted    Boolean         @default(false)
  parentId     String?         @db.Uuid
  testData     Boolean         @default(false)
  flaggedCount Int             @default(0)
  isFlagged    Boolean         @default(false)
  helpful      ReviewHelpful[]
  parent       Review?         @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Review[]        @relation("ReviewReplies")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([perfumeId])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([rating])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpful")
}

model Rating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  perfumeId String   @db.VarChar(255)
  rating    Int      @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId])
  @@index([perfumeId])
  @@index([rating])
  @@map("ratings")
}

model SimilarPerfumeVote {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  sourcePerfumeId  String   @db.VarChar(255)
  similarPerfumeId String   @db.VarChar(255)
  voteType         VoteType 
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourcePerfumeId, similarPerfumeId])
  @@index([sourcePerfumeId])
  @@index([similarPerfumeId])
  @@index([voteType])
  @@map("similar_perfume_votes")
}

model WardrobeEntry {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @db.Uuid
  perfumeId   String         @db.VarChar(255)
  subcategory String         @db.VarChar(100)
  status      WardrobeStatus
  notes       String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId])
  @@index([userId])
  @@index([status])
  @@map("wardrobe")
}

model Follow {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String       @db.Uuid
  followingId String       @db.Uuid
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  approvedAt  DateTime?     @db.Timestamptz(6)
  follower    User         @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User         @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([status])
  @@map("follows")
}

model BrandFollow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  brandId   String   @db.VarChar(255)  // MongoDB ObjectId as string
  brandName String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
  @@map("brand_follows")
}

model ThreadFollow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  perfumeId String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, perfumeId])
  @@index([userId])
  @@index([perfumeId])
  @@map("thread_follows")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  testData  Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Category {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @unique @db.VarChar(100)
  slug         String       @unique @db.VarChar(100)
  description  String?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  collections  Collection[]

  @@index([slug])
  @@map("categories")
}

model Collection {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(200)
  slug         String    @unique @db.VarChar(200)
  description  String?
  categoryId   String?   @db.Uuid
  perfumeIds   String[]  @db.VarChar(255)
  thumbnailUrl String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([categoryId])
  @@map("collections")
}

model Price {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  perfumeId    String   @db.VarChar(255)
  retailerName String   @db.VarChar(100)
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @db.VarChar(3)
  region       String   @db.VarChar(50)
  bottleSize   String   @db.VarChar(20)
  url          String?
  lastUpdated  DateTime @default(now()) @db.Timestamptz(6)

  @@index([perfumeId])
  @@index([region])
  @@index([lastUpdated])
  @@map("prices")
}

model CommunitySubmission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  type        SubmissionType
  data        Json
  status      SubmissionStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  processedAt DateTime?        @db.Timestamptz(6)
  testData    Boolean          @default(false)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("community_submissions")
}

model BrandOwnerSubmission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandName        String           @db.VarChar(200)
  companyName      String           @db.VarChar(200)
  country          String           @db.VarChar(100)
  website          String?
  contactName      String           @db.VarChar(100)
  contactEmail     String           @db.VarChar(255)
  contactPhone     String?          @db.VarChar(20)
  position         String?          @db.VarChar(100)
  brandData        Json
  perfumesData     Json
  verificationDocs String[]
  status           SubmissionStatus @default(PENDING)
  adminNotes       String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  processedAt      DateTime?        @db.Timestamptz(6)
  testData         Boolean          @default(false)

  @@index([status])
  @@index([contactEmail])
  @@index([createdAt(sort: Desc)])
  @@map("brand_owner_submissions")
}

model AutoUpdateQueue {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String           @db.VarChar(50)
  source          String
  data            Json
  confidenceScore Decimal          @db.Decimal(5, 2)
  flaggedReason   String?
  status          SubmissionStatus @default(PENDING)
  adminNotes      String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  processedAt     DateTime?        @db.Timestamptz(6)

  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("auto_update_queue")
}

model AdminActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @db.Uuid
  action    String   @db.VarChar(100)
  target    String   @db.VarChar(255)
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([adminId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("admin_activity_logs")
}

model FeaturedItem {
  id        String   @id @default(cuid())
  type      String
  mongoId   String
  position  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([mongoId])
}

model ArticleComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  testData  Boolean  @default(false)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
  @@map("article_comments")
}

model Article {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String           @unique @db.VarChar(255)
  title             String           @db.VarChar(255)
  excerpt           String
  content           String
  coverImage        String?
  category          String           @db.VarChar(50)
  readTime          String           @db.VarChar(20)
  authorId          String           @db.Uuid
  mentionedPerfumes String[]         @db.VarChar(255)
  published         Boolean          @default(false)
  publishedAt       DateTime?        @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  testData          Boolean          @default(false)
  comments          ArticleComment[]
  author            User             @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([published])
  @@index([category])
  @@map("articles")
}

model FeaturedPerfume {
  id        String   @id @default(cuid())
  perfumeId String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("featured_perfumes")
}

model TrendingBrand {
  id        String   @id @default(cuid())
  brandId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("trending_brands")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  targetId   String?  @db.VarChar(255)
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("activity_logs")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
  EDITOR
}

enum WardrobeStatus {
  CURRENTLY_USING
  WISH_LIST
  USED_UP
  IN_COLLECTION
  GIFTED
  DECANT
}

enum NotificationType {
  NEW_FOLLOWER
  FOLLOW_REQUEST        
  FOLLOW_APPROVED       
  BRAND_NEW_RELEASE     
  REVIEW_HELPFUL
  REVIEW_LIKE
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SYSTEM_ANNOUNCEMENT
  REVIEW_REPLY
  THREAD_ACTIVITY
}

enum SubmissionType {
  BRAND
  PERFUME
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteType {
  UP
  DOWN
}

enum FollowStatus {
  PENDING
  APPROVED
  REJECTED
}